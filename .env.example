# Snowflake connection — used by the Flask backend and local integration tests.
# In SPCS, SNOWFLAKE_HOST is injected automatically; set it here only for local dev.
SNOWFLAKE_ACCOUNT=<org>-<account>          # e.g. myorg-myaccount
SNOWFLAKE_HOST=<org>-<account>.snowflakecomputing.com
SNOWFLAKE_WAREHOUSE=INVOICE_OPS_WH_XS
SNOWFLAKE_DATABASE=INVOICE_OPS
SNOWFLAKE_SCHEMA=AI

# Used by the synthetic data generator and local integration tests only.
# Never put real credentials in .env; use the SPCS OAuth token in production.
SNOWFLAKE_USER=<your-snowflake-username>
SNOWFLAKE_PASSWORD=<your-snowflake-password>   # local dev / integration tests only

# Snowflake image registry (format: <org>-<account>.registry.snowflakecomputing.com)
SNOWFLAKE_REGISTRY=<org>-<account>.registry.snowflakecomputing.com
IMAGE_REPO=invoice_ops/infra/app_repo

# Flask
FLASK_ENV=development
FLASK_DEBUG=1

# Set to 1 to run integration tests against a real Snowflake account.
# Gated in CI — only enable locally before opening a PR that touches SQL or the backend.
RUN_INTEGRATION=0
